# ─── Momentum env (committed with DUMMY values; real secrets live in Secret Manager) ───
# Identity / access (Google-only, pinned owner)
OWNER_EMAIL=divyamohan1993@gmail.com
SESSION_SECRET=                 # >=32 random bytes (base64url) — signs the session JWT
FIELD_KEY=                      # 32 random bytes (base64) — AES-256-GCM field encryption
EDGE_SECRET=                    # optional: shared secret injected by Cloudflare; when set,
                                # direct run.app hits without it get a static 403 (review B3)

# Brain (server-only; never in client bundle)
VERTEX_LOCATION=global         # ADC from the Cloud Run runtime service account
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_DAILY_CAP=200            # paid attempts/day, including retries; hard maximum 200

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:divyamohan1993@gmail.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=   # public key is safe to ship to the client

# GCP / Firestore
GCP_PROJECT=dmjone
FIRESTORE_DATABASE=(default)
# Service account email allowed to call /api/sweep via OIDC (Cloud Scheduler)
SWEEP_INVOKER_SA=

# Runtime
TZ=Asia/Kolkata
NODE_ENV=development

# Google-only authentication: public Firebase config + pinned owner identity
APP_ORIGIN=https://momentum.dmj.one
OWNER_GOOGLE_UID=
OWNER_GOOGLE_SUB=
FIREBASE_API_KEY=               # public, restricted to browser Auth APIs; never Vertex
FIREBASE_APP_ID=
