  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@js-temporal/polyfill": "^0.5.1",
    "cmdk": "^1.1.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.4.0",
    "google-auth-library": "^9.15.1",
    "jose": "^6.0.11",
    "motion": "^12.23.12",
    "next": "^15.5.24",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/web-push": "^3.6.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
