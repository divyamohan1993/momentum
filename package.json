{
  "name": "momentum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "gen:vapid": "node scripts/gen-vapid.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
